# Referencia do preset 'moya', NAO editar para mudar o host: a fonte da
# verdade e hosts/moya/host.toml e o `homelabctl render` gera o
# /etc/homelab-storage-admin/host.env. Este arquivo so entra quando o host
# ainda nao tem TOML; o install-agent.sh nunca sobrescreve um host.env.
SITE_NAME="Moya Storage"
HOST_PROFILE=moya
STORAGE_ROOT=/mnt/data
SNAPSHOT_ROOT=/mnt/data/.snapshots
ALLOWED_PATH_PREFIXES=/mnt/data/
DF_MOUNTS=/,/mnt/data
SHARE_OWNER=conrado
SSH_LOGIN=conrado@10.72.60.181
SNAPSHOT_DENYLIST=Veronte_Images
SNAPSHOT_BACKEND=rsync
BACKUP_ROOT=/mnt/data/backups
AGENT_SOCKET=/run/homelab-storage-admin/agent.sock
TERMINAL_SOCKET=/run/homelab-storage-admin/terminal.sock
AGENT_SOCKET_DIR=/run/homelab-storage-admin
BIND_ADDR=127.0.0.1
BIND_PORT=8060
COMPOSE_OVERLAY=docker-compose.moya.yml
CREDENTIALS_MANAGE_USERS=1
# Fonte da verdade das rotas do Caddy e do DNS (apps-sync.sh --perfil moya).
APPS_ENV_PATH=/opt/stacks/homelab-storage-admin/deploy/moya/apps.env
# Admins locais (break-glass) dos apps Django via agente. 1 liga a pagina.
DJANGO_ADMIN_MANAGE=1
# Gestao do firewall UFW pela UI (1 liga; 0 somente leitura).
FIREWALL_MANAGE=1
SYSTEM_MANAGE=1
TERMINAL_ENABLE=1
# Portas preservadas ao ativar o UFW (somente as que estiverem em uso publico).
FIREWALL_SAFE_PORTS=22/tcp,53/tcp,53/udp,80/tcp,443/tcp,8060/tcp,222/tcp,3000/tcp,8010/tcp,8040/tcp,8070/tcp,8888/tcp,9090/tcp,10000/tcp,137/udp,138/udp,139/tcp,445/tcp,3702/udp,5357/tcp,5353/udp,9993/udp
DATA_DIR=/mnt/data/apps/storage/data
DOWNLOAD_DIR=/mnt/data/apps/storage/data/downloads
# Backup local do Credenciais (banco + .env), sem restic.
CREDENCIAIS_DB=/mnt/data/apps/credenciais/data/db.sqlite3
CREDENCIAIS_ENV=/home/conrado/moya_credenciais_app/.env
CREDENCIAIS_BACKUP_DIR=/var/backups/moya-credenciais
CREDENCIAIS_CONTAINER=moya-credenciais
CREDENCIAIS_TIME=03:30
CREDENCIAIS_RETENTION_DAYS=30
CREDENCIAIS_MAX_SOURCE_BYTES=2147483648
