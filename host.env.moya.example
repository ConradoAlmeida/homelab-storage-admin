# Perfil do moyaserver. Copie para /etc/homelab-storage-admin/host.env.
SITE_NAME="Moya Storage"
STORAGE_ROOT=/srv/samba
SNAPSHOT_ROOT=/srv/samba/.snapshots
ALLOWED_PATH_PREFIXES=/srv/samba/,/mnt/data/
DF_MOUNTS=/,/srv/samba,/mnt/data
SHARE_OWNER=conrado
SNAPSHOT_DENYLIST=Veronte_Images
SNAPSHOT_BACKEND=rsync
BACKUP_ROOT=/mnt/data/backups
AGENT_SOCKET=/run/homelab-storage-admin/agent.sock
AGENT_SOCKET_DIR=/run/homelab-storage-admin
BIND_ADDR=127.0.0.1
BIND_PORT=8060
COMPOSE_OVERLAY=docker-compose.moya.yml
CREDENTIALS_MANAGE_USERS=1
# Gestao do firewall UFW pela UI (1 liga; 0 somente leitura).
FIREWALL_MANAGE=1
# Portas preservadas ao ativar o UFW (somente as que estiverem em uso publico).
FIREWALL_SAFE_PORTS=22/tcp,53/tcp,53/udp,80/tcp,443/tcp,8060/tcp,137/udp,138/udp,139/tcp,445/tcp
DATA_DIR=/opt/stacks/homelab-storage-admin/data
DOWNLOAD_DIR=/opt/stacks/homelab-storage-admin/data/downloads
# Backup local do Credenciais (banco + .env), sem restic.
CREDENCIAIS_DB=/home/conrado/moya_credenciais_app/data/db.sqlite3
CREDENCIAIS_ENV=/home/conrado/moya_credenciais_app/.env
CREDENCIAIS_BACKUP_DIR=/var/backups/moya-credenciais
CREDENCIAIS_CONTAINER=moya-credenciais
CREDENCIAIS_TIME=03:30
CREDENCIAIS_RETENTION_DAYS=30
CREDENCIAIS_MAX_SOURCE_BYTES=2147483648
