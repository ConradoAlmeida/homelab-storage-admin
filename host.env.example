# Perfil do host. Copie para /etc/homelab-storage-admin/host.env.
# O install-agent.sh NUNCA sobrescreve um host.env existente.
SITE_NAME="Homelab Storage"
STORAGE_ROOT=/mnt/nas
SNAPSHOT_ROOT=/mnt/nas/.snapshots
ALLOWED_PATH_PREFIXES=/mnt/nas/
DF_MOUNTS=/,/mnt/nas,/mnt/backup,/mnt/jellyfin
JELLYFIN_ROOT=/mnt/jellyfin
SHARE_OWNER=conrado
SNAPSHOT_DENYLIST=
SNAPSHOT_BACKEND=auto
BACKUP_ROOT=/mnt/backup
AGENT_SOCKET=/run/homelab-storage-admin/agent.sock
AGENT_SOCKET_DIR=/run/homelab-storage-admin
BIND_ADDR=192.168.0.150
BIND_PORT=8060
COMPOSE_OVERLAY=docker-compose.homelab.yml
CREDENTIALS_MANAGE_USERS=0
# Gestao do firewall UFW pela UI (1 liga; 0 somente leitura).
FIREWALL_MANAGE=1
# Portas preservadas ao ativar o UFW (somente as que estiverem em uso publico).
FIREWALL_SAFE_PORTS=22/tcp,53/tcp,53/udp,80/tcp,443/tcp,8060/tcp,137/udp,138/udp,139/tcp,445/tcp
DATA_DIR=/mnt/nas/apps/homelab-storage-admin/data
DOWNLOAD_DIR=/mnt/nas/apps/homelab-storage-admin/data/downloads
