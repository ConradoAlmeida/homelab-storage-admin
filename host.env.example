# Perfil do host. Copie para /etc/homelab-storage-admin/host.env.
# O install-agent.sh NUNCA sobrescreve um host.env existente.
SITE_NAME="Homelab Storage"
STORAGE_ROOT=/mnt/nas
SNAPSHOT_ROOT=/mnt/nas/.snapshots
ALLOWED_PATH_PREFIXES=/mnt/nas/
DF_MOUNTS=/,/mnt/nas,/mnt/backup,/mnt/jellyfin
JELLYFIN_ROOT=/mnt/jellyfin
SHARE_OWNER=conrado
SSH_LOGIN=conrado@homelab.local
SNAPSHOT_DENYLIST=
SNAPSHOT_BACKEND=auto
BACKUP_ROOT=/mnt/backup
AGENT_SOCKET=/run/homelab-storage-admin/agent.sock
# Segundo socket do agente (terminal). Default: mesmo diretório que AGENT_SOCKET.
TERMINAL_SOCKET=/run/homelab-storage-admin/terminal.sock
AGENT_SOCKET_DIR=/run/homelab-storage-admin
BIND_ADDR=192.168.0.150
BIND_PORT=8060
COMPOSE_OVERLAY=docker-compose.homelab.yml
CREDENTIALS_MANAGE_USERS=0
# Gestao do firewall UFW pela UI (1 liga; 0 somente leitura).
FIREWALL_MANAGE=1
# Gestao de pacotes apt e units systemd (1 liga; 0 somente leitura).
SYSTEM_MANAGE=1
# Terminal no navegador (segundo socket do agente). 1 mostra; 0 oculta.
# A sessão pede a senha sudo da conta Linux e abre o shell desse usuário.
TERMINAL_ENABLE=1
# Portas preservadas ao ativar o UFW (somente as que estiverem em uso publico).
FIREWALL_SAFE_PORTS=22/tcp,53/tcp,53/udp,80/tcp,443/tcp,8060/tcp,5001/tcp,8080/tcp,137/udp,138/udp,139/tcp,445/tcp
DATA_DIR=/mnt/nas/apps/homelab-storage-admin/data
DOWNLOAD_DIR=/mnt/nas/apps/homelab-storage-admin/data/downloads
# O qBittorrent do homelab é o serviço do overlay, na rede do Pi.
# A WebUI fica na 8090, alcançada pelo painel como http://qbittorrent:8090.
# A 8080 do host não é usada por esse container.
JELLYFIN_CONTAINER=jellyfin
# Primeiro token da API de torrents. Só entra se o banco ainda não tiver um.
# A troca seguinte é na página Torrents. Vazio aqui não apaga um token já gravado.
TORRENT_API_TOKEN=
