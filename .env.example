# Copie para .env e troque os valores. Nunca comite o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=192.168.0.150,homelab,homelab.local,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.0.150:8060,http://homelab:8060,http://homelab.local:8060
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
DJANGO_SUPERUSER_EMAIL=admin@homelab.local
DJANGO_SECURE_COOKIES=0
AGENT_SOCKET=/run/homelab-storage-admin/agent.sock
# DJANGO_SQLITE_PATH: use só em comandos no host do Pi; no container o default /app/data/db.sqlite3 basta.
# DJANGO_SQLITE_PATH=/mnt/nas/apps/homelab-storage-admin/data/db.sqlite3
