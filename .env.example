# Copie para .env e troque os valores. Nunca comite o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=192.168.0.150,homelab,homelab.local,homelab.conradhub.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.0.150:8060,http://homelab:8060,http://homelab.local:8060,https://homelab.conradhub.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-esta-senha
DJANGO_SUPERUSER_EMAIL=admin@homelab.local
DJANGO_SECURE_COOKIES=0
AGENT_SOCKET=/run/homelab-storage-admin/agent.sock
# Só no moyaserver: login pelo Credenciais. Vazio no Pi = login local.
CREDENTIALS_URL=http://moya-credenciais:8080
CREDENTIALS_API_TOKEN=
CREDENTIALS_APP=storage
# Ligue DJANGO_SECURE_COOKIES=1 quando o mesmo https://homelab.conradhub.com
# valer em casa e no Tailscale. No Pi isso já vale (deploy de 2026-11-04):
# o login grava cookie Secure; http://192.168.0.150:8060 abre e não mantém sessão.
# Instalação nova deixa 0 até esse nome existir nos dois lados.
# DJANGO_SQLITE_PATH: use só em comandos no host do Pi; no container o default /app/data/db.sqlite3 basta.
# DJANGO_SQLITE_PATH=/mnt/nas/apps/homelab-storage-admin/data/db.sqlite3
