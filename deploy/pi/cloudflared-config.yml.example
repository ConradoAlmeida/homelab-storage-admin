# Config do Cloudflare Tunnel do Pi.
# Instale como /etc/cloudflared/config.yml (root:cloudflared, 0640).
#
# `tunnel` e `credentials-file` vêm de `cloudflared tunnel create homelab`.
# Rotas DNS (sem pihole): cloudflared tunnel route dns homelab <hostname>.
tunnel: TROQUE-PELO-UUID
credentials-file: /etc/cloudflared/TROQUE-PELO-UUID.json

# Ingress para o Caddy (TLS local). Um bloco por hostname público; o resto 404.
ingress:
  - hostname: homelab.conradhub.com
    service: https://192.168.0.150
    originRequest:
      connectTimeout: 10s
      noTLSVerify: true
  - hostname: cockpit.conradhub.com
    service: https://192.168.0.150
    originRequest:
      connectTimeout: 10s
      noTLSVerify: true
  - hostname: dockge.conradhub.com
    service: https://192.168.0.150
    originRequest:
      connectTimeout: 10s
      noTLSVerify: true
  - hostname: jellyfin.conradhub.com
    service: https://192.168.0.150
    originRequest:
      connectTimeout: 10s
      noTLSVerify: true
  - service: http_status:404
