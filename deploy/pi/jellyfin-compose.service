[Unit]
Description=Jellyfin after the media disk is mounted
After=docker.service mnt-jellyfin.mount mnt-nas.mount
Requires=docker.service mnt-jellyfin.mount mnt-nas.mount
BindsTo=mnt-jellyfin.mount

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/stacks/jellyfin
ExecStartPre=/usr/bin/findmnt --mountpoint /mnt/jellyfin
ExecStartPre=/usr/bin/findmnt --mountpoint /mnt/nas
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
