# Apps expostas pelo Caddy do moyaserver. Fonte da verdade do
# scripts/stacks/apps-sync.sh --perfil moya; o host.env aponta APPS_ENV_PATH
# para este arquivo no checkout, entao o deploy.sh (git pull) mantem env e
# script no mesmo commit.
#
# Uma app por linha: key|fqdn|upstream|dir|flags
#   key       identificador curto [a-z0-9-]; nome da pasta na quarentena
#   fqdn      nome publico, sempre dentro de .local
#   upstream  host:porta que o Caddy alcanca (ele roda em host network)
#   dir       pasta do stack (ou `-` quando a app nao tem stack aqui); o
#             projeto compose e lido do rotulo working_dir do container
#   flags     opcional, separado por virgula:
#               manual            bloco inteiro escrito a mao no Caddyfile
#               redir=<destino>   redireciona a raiz do site (302)
#               redir=<origem>-><destino>[@codigo]
#               snippet=<nome>    embute deploy/moya/snippets/<nome>.caddy
#               atalho=painel     atalho no botao Servicos do painel
#               atalho=portal     card no portal do moya
#               atalho=painel+portal
#               nome=, descricao=, cor=#rrggbb, icone=<slug>
#                                 texto, cor e icone do atalho
#
# Sem `atalho=` a app tem rota e DNS, mas nao aparece no painel nem no portal.
# `moya-portal` e o proprio portal: nao aponta para si mesmo.
#
# DNS: uma entrada por nome em /home/conrado/pihole/etc-dnsmasq.d/, gerada
# daqui. `.local` e reservado para mDNS, entao nao ha wildcard.
#
# O Caddy do moya e compose nativo em /opt/stacks/caddy: o gerador escreve
# apps.caddy (importado pelo Caddyfile), valida e recarrega o container.
# Os atalhos sao gerados em DATA_DIR/services.ini (painel) e em
# /var/lib/homelab-storage-admin/apps-portal.ini (portal, montado read-only).

moya-git|moya-git.local|localhost:3000|/opt/stacks/gitea|atalho=portal,nome=Gitea,descricao=Git repositories,icone=gitea,cor=#4a9eff,grupo=services
moya-pihole|moya-pihole.local|localhost:8888|-|redir=/admin,atalho=portal,nome=Pi-hole,descricao=DNS ad blocking,icone=pihole,cor=#ff6b6b,grupo=services
moya-datalogger|moya-datalogger.local|localhost:8052|/home/conrado/Data-Logger-Plotter|atalho=portal,nome=Data Logger,descricao=Telemetry plots,icone=datalogger,cor=#f0a030,grupo=tools
moya-docs|moya-docs.local|localhost:8010|/home/conrado/Datasheet_Manager|atalho=portal,nome=Moya Datasheets,descricao=Technical documentation,icone=datasheets,cor=#4a9eff,grupo=tools
moya-portal|moya-portal.local|localhost:8020|/home/conrado/moya_portal_interno|
moya-calcula-cabo|moya-calcula-cabo.local|localhost:8030|/home/conrado/calcula_cabo|atalho=portal,nome=Calcula Cabo,descricao=DC cable sizing (UAS),icone=calcula-cabo,cor=#3ceef8,grupo=tools
moya-weather|moya-weather.local|10.72.60.202:80|-|atalho=portal,nome=Moya Weather,descricao=Local weather station,icone=weather,cor=#3ceef8,grupo=services
moya-drawings|moya-drawings.local|localhost:8040|/home/conrado/moya_drawing_manager|atalho=portal,nome=Drawing Manager,descricao=PDF & STEP drawings,icone=drawings,cor=#5cd6a8,grupo=tools
moya-storage|moya-storage.local|localhost:8060|/opt/stacks/homelab-storage-admin|atalho=portal,nome=Storage Admin,descricao=Samba shares & snapshots,icone=storage,cor=#a78bfa,grupo=infrastructure
moya-versoes|moya-versoes.local|localhost:8070|/home/conrado/moya_sharepoint_analysis|atalho=painel+portal,nome=SharePoint Management,descricao=SharePoint version backups,icone=datasheets,cor=#f0a030,grupo=infrastructure
moya-credenciais|moya-credenciais.local|localhost:8080|/home/conrado/moya_credenciais_app|atalho=painel+portal,nome=Credenciais,descricao=Senha única dos sites e do Samba,icone=credenciais,cor=#4a9eff,grupo=tools
moya-processos|moya-processos.local|localhost:8041|/home/conrado/moya_process_manager|atalho=portal,nome=Process Manager,descricao=Interactive process sheets,icone=processos,cor=#f0a030,grupo=tools
