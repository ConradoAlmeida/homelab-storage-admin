# Formato do services.ini gerado pelo apps-sync a partir do apps.env.
# No host o arquivo e gerado (atalho=painel); este exemplo serve de
# referencia e para um host que nao use o apps-sync. Servico sem url
# valida nao aparece.
#
# Campos: name, description, url, icon, color, order, group.
# `group` so o portal do moya usa (services, infrastructure, tools).
# Icones conhecidos: jellyfin, dockge, pihole; outros usam o icone
# generico. Nao ha descoberta nem health check.
# URLs https://*.conradhub.com. Sem DNS público: em casa o Pi-hole,
# fora só com Tailscale. pihole.conradhub.com só nesses dois casos.

[jellyfin]
name = Jellyfin
description = Midia · filmes e series
url = https://jellyfin.conradhub.com
icon = jellyfin
color = #a78bfa
order = 10

[dockge]
name = Dockge
description = Containers · stacks
url = https://dockge.conradhub.com
icon = dockge
color = #fbbf24
order = 30

[pihole]
name = Pi-hole
description = DNS · anuncios
url = https://pihole.conradhub.com/admin/
icon = pihole
color = #fb7185
order = 40
