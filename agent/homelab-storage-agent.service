[Unit]
Description=Homelab Storage Admin Agent
After=network.target smbd.service
Wants=smbd.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/homelab-storage-agent
Restart=on-failure
RestartSec=2
RuntimeDirectory=homelab-storage-admin
RuntimeDirectoryMode=0755
# Preserva o diretorio: o container tem bind mount nele e perderia o socket
RuntimeDirectoryPreserve=yes
# Perfil do host. O arquivo e opcional para nao impedir o boot se faltar.
EnvironmentFile=-/etc/homelab-storage-admin/host.env

[Install]
WantedBy=multi-user.target
